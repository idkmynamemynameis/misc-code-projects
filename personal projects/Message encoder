import math
num_to_letter = {0:'a',1:'b',2:'c',3:'d',4:'e',5:'f',6:'g',7:'h',8:'i',9:'j',
                 10:'k',11:'l',12:'m',13:'n',14:'o',15:'p',16:'q',17:'r',
                 18:'s',19:'t',20:'u',21:'v',22:'w',23:'x',24:'y',25:'z'}
letter_to_num = {'a':0,'b':1,'c':2,'d':3,'e':4,'f':5,'g':6,'h':7,'i':8,'j':9,
                 'k':10,'l':11,'m':12,'n':13,'o':14,'p':15,'q':16,
                 'r':17,'s':18,'t':19,'u':20,'v':21,'w':22,'x':23,
                 'y':24,'z':25}
def cesear_cypher(message,key,encode=True):
    if encode:
        tokens = [letter_to_num[char] for char in message]
        for i in range(len(tokens)):
            tokens[i] = (tokens[i]+key)%26
        encoded_message = ''.join([num_to_letter[token] for token in tokens])
        return encoded_message
    else:
        # Decoding logic here
        tokens = [letter_to_num[char] for char in message]
        for i in range(len(tokens)):
            tokens[i] = (tokens[i]-key)%26
        decoded_message = ''.join([num_to_letter[token] for token in tokens])
        return decoded_message
def vigenere_cypher(message,key,encode=True):
    key_length = len(key)
    if encode:
        tokens = [letter_to_num[char] for char in message]
        key_tokens = [letter_to_num[char] for char in key]
        for i in range(len(tokens)):
            tokens[i] = (tokens[i]+key_tokens[i%key_length])%26
        encoded_message = ''.join([num_to_letter[token] for token in tokens])
        return encoded_message
    else:
        # Decoding logic here
        tokens = [letter_to_num[char] for char in message]
        key_tokens = [letter_to_num[char] for char in key]
        for i in range(len(tokens)):
            tokens[i] = (tokens[i]-key_tokens[i%key_length])%26
        decoded_message = ''.join([num_to_letter[token] for token in tokens])
        return decoded_message
def playfair_cypher(message,key,encode=True):
    # Create the 5x5 matrix
    matrix = []
    used_chars = set()
    for char in key:
        if char not in used_chars and char != 'j':
            matrix.append(char)
            used_chars.add(char)
    for char in num_to_letter.values():
        if char not in used_chars and char != 'j':
            matrix.append(char)
            used_chars.add(char)
    matrix = [matrix[i:i+5] for i in range(0, 25, 5)]
    
    def find_position(char):
        for i in range(5):
            for j in range(5):
                if matrix[i][j] == char:
                    return (i, j)
        return None
    
    def encode_pair(pair):
        pos1 = find_position(pair[0])
        pos2 = find_position(pair[1])
        if pos1[0] == pos2[0]:  # Same row
            return (matrix[pos1[0]][(pos1[1]+1)%5], matrix[pos2[0]][(pos2[1]+1)%5])
        elif pos1[1] == pos2[1]:  # Same column
            return (matrix[(pos1[0]+1)%5][pos1[1]], matrix[(pos2[0]+1)%5][pos2[1]])
        else:  # Rectangle
            return (matrix[pos1[0]][pos2[1]], matrix[pos2[0]][pos1[1]])
    
    def decode_pair(pair):
        pos1 = find_position(pair[0])
        pos2 = find_position(pair[1])
        if pos1[0] == pos2[0]:  # Same row
            return (matrix[pos1[0]][(pos1[1]-1)%5], matrix[pos2[0]][(pos2[1]-1)%5])
        elif pos1[1] == pos2[1]:  # Same column
            return (matrix[(pos1[0]-1)%5][pos1[1]], matrix[(pos2[0]-1)%5][pos2[1]])
        else:  # Rectangle
            return (matrix[pos1[0]][pos2[1]], matrix[pos2[0]][pos1[1]])
    
    # Prepare the message by removing spaces and handling 'j'
    message = message.replace(' ', '').replace('j', 'i')
    pairs = []
    i = 0
    while i < len(message):
        if i+1 < len(message) and message[i] != message[i+1]:
            pairs.append((message[i], message[i+1]))
            i += 2
        else:
            pairs.append((message[i], 'x'))  # Add 'x' as a filler
            i += 1